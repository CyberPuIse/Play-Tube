<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: blank system splash (our own animation follows immediately). -->
    <style name="Theme.PlayTube.Splash" parent="Theme.PlayTube">
        <item name="android:windowBackground">@color/splash_bg</item>
        <item name="android:statusBarColor">@color/splash_bg</item>
        <item name="android:navigationBarColor">@color/splash_bg</item>
        <item name="android:windowSplashScreenBackground">@color/splash_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_empty</item>
    </style>
</resources>
