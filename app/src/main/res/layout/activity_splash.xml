<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="160dp"
            android:layout_height="110dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <View
                android:id="@+id/ring1"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center"
                android:alpha="0"
                android:background="@drawable/bg_splash_ring" />

            <View
                android:id="@+id/ring2"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center"
                android:alpha="0"
                android:background="@drawable/bg_splash_ring" />

            <View
                android:id="@+id/glow"
                android:layout_width="240dp"
                android:layout_height="240dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_splash_glow" />

            <FrameLayout
                android:id="@+id/logoFrame"
                android:layout_width="96dp"
                android:layout_height="68dp"
                android:layout_gravity="center"
                android:clipChildren="true">

                <ImageView
                    android:id="@+id/logoButton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_splash_button" />

                <ImageView
                    android:id="@+id/logoPlay"
                    android:layout_width="38dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_splash_play" />

                <View
                    android:id="@+id/logoShine"
                    android:layout_width="34dp"
                    android:layout_height="120dp"
                    android:layout_gravity="center_vertical"
                    android:alpha="0"
                    android:background="@drawable/bg_splash_shine" />
            </FrameLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/wordRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clipChildren="false"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/premiumBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_premium_badge"
            android:letterSpacing="0.2"
            android:paddingStart="12dp"
            android:paddingTop="3dp"
            android:paddingEnd="12dp"
            android:paddingBottom="3dp"
            android:text="@string/premium_label"
            android:textAllCaps="true"
            android:textColor="@android:color/white"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/loadTrack"
        android:layout_width="120dp"
        android:layout_height="4dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="44dp"
        android:alpha="0"
        android:background="@drawable/bg_splash_track">

        <View
            android:id="@+id/loadBar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_splash_fill"
            android:scaleX="0"
            android:transformPivotX="0dp" />
    </FrameLayout>

    <TextView
        android:id="@+id/tagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="72dp"
        android:letterSpacing="0.12"
        android:text="@string/splash_tagline"
        android:textColor="@color/on_surface_variant"
        android:textSize="12sp" />
</FrameLayout>
